# Copy to .env.local (for `npm run dev` / builds) and .dev.vars (for `npm run preview`).
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time, so they must
# also be set as build variables in Cloudflare Workers Builds. Everything else is a
# runtime secret: Cloudflare → Workers → amioprowears → Settings → Variables and Secrets.

# Site
NEXT_PUBLIC_SITE_URL=https://amioprowears.com
NEXT_PUBLIC_STORE_NAME=Amioprowears
NEXT_PUBLIC_SUPPORT_EMAIL=support@amioprowears.com
NEXT_PUBLIC_SUPPORT_PHONE=
# Your WhatsApp number for the chat button: 234 + number without the leading 0 (0803… → 234803…)
NEXT_PUBLIC_WHATSAPP_CHAT_NUMBER=

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=               # secret — never prefix with NEXT_PUBLIC_

# Paystack — Settings → API Keys & Webhooks (use test keys until launch)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=                     # secret

# Crypto (future)
ENABLE_CRYPTO=false

# Brevo
BREVO_API_KEY=                           # secret
BREVO_SENDER_EMAIL=orders@amioprowears.com
BREVO_SENDER_NAME=Amioprowears
BREVO_LIST_ID=

# Owner alerts
TELEGRAM_BOT_TOKEN=                      # secret
TELEGRAM_CHAT_ID=
OWNER_EMAIL=admin@amioprowears.com
